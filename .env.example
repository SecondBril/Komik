# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Configuration
ADMIN_EMAIL_ALLOWLIST=admin@komik.id,operator@komik.id

# Primary Storage: Microsoft OneDrive (Microsoft Graph API)
ONEDRIVE_CLIENT_ID=your-azure-app-client-id
ONEDRIVE_CLIENT_SECRET=your-azure-app-client-secret
ONEDRIVE_TENANT_ID=consumers
ONEDRIVE_REFRESH_TOKEN=your-onedrive-refresh-token
ONEDRIVE_ROOT_FOLDER=comics

# Secondary Storage: ImageKit CDN (Fallback)
R2_PUBLIC_CDN_URL=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=public_your_key
IMAGEKIT_PRIVATE_KEY=private_your_key
